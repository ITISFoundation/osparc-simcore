#
# Specifies third-party dependencies for 'simcore-postgres-database'
#
--constraint ../../../requirements/constraints.txt
--constraint ./constraints.txt
--requirement ../../../packages/common-library/requirements/_base.in

alembic
pydantic
sqlalchemy[postgresql_asyncpg] # the asyncpg driver, which also brings the asyncio extra (greenlet). No sync driver here: only the sc-pg CLI (see _migration.in) and the test envs open sync connections
yarl
