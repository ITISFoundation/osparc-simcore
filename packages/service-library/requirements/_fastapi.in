#
# Dependencies for exclusive to fastapi-based services
#
#
--constraint ../../../requirements/constraints.txt
--constraint ./constraints.txt

# Adds base AS CONSTRAINT specs, not requirement, so shared transitives
# (e.g. protobuf, opentelemetry-*) resolve to the same pins as _base.txt.
--constraint _base.txt

asgi-lifespan
fastapi[standard]
fastapi-lifespan-manager
opentelemetry-instrumentation-fastapi
prometheus-client
