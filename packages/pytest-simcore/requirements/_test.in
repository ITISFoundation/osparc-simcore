#
# Specifies dependencies required to run 'pytest-simcore'
#
--constraint ../../../requirements/constraints.txt


aiodocker
# 'alembic' is normally pulled ONLY via simcore-postgres-database's [migration] extra, but
# 'uv pip sync' (used by make install-ci) does not resolve extras from requirements files
# -> listed explicitly here for the postgres template-DB fixtures
alembic
arrow
coverage
docker
faker
fastapi
orjson
playwright
pydantic
pydantic-extra-types
pytest
pytest-asyncio
pytest-cov
pytest-icdiff
pytest-instafail
pytest-mock
pytest-runner
pytest-sugar
python-dotenv
python-socketio
pyyaml
sqlalchemy[mypy]
tenacity
types-aiofiles
uvicorn
