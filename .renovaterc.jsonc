{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboardApproval"
  ],
  "dependencyDashboard": true,
  "prCreation": "approval",
  "platformAutomerge": true,
  "automerge": true,
  "branchPrefix": "renovate/",
  "commitMessageSuffix": " [Renovate]",
  // Tools Renovate installs for pip-compile and its post-upgrade task; keep in sync
  // with requirements/UV_VERSION and requirements/PYTHON_VERSION
  // (checked by tests/environment-setup/test_used_{uv,python}.py)
  "constraints": {
    "python": "~=3.14.0",
    "uv": "0.13.0"
  },
  "labels": [
    "t:maintenance"
  ],
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": true
  },
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "timezone": "Europe/Zurich",
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements/_[^/]+\\.txt$/",
      "/(^|/)api/tests/requirements\\.txt$/",
      "/(^|/)ci/helpers/requirements/requirements\\.txt$/",
      "/(^|/)tests/e2e-playwright/requirements/_[^/]+\\.txt$/",
      "/(^|/)tests/environment-setup/requirements/requirements\\.txt$/"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 3am on the first day of the month"
    ]
  },
  "packageRules": [
    {
      "description": "pip-compile lockfiles (e.g. _test.txt, _tools.txt) reference _base.txt as a --constraint, so packages only pinned there (not required directly by their own .in file) are classified by Renovate as 'indirect' deps and ignored by default. Force-enable them so they don't silently drift out of sync (e.g. stay on an old, vulnerable version) whenever _base.txt is bumped.",
      "matchManagers": [
        "pip-compile"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Group all pip-compile outputs (_base.txt, _test.txt, _tools.txt, ...) of the same requirements/ directory into a single branch/PR, so they are always updated atomically instead of drifting apart",
      "matchManagers": [
        "pip-compile"
      ],
      "groupName": "{{packageFileDir}}",
      "groupSlug": "{{packageFileDir}}"
    },
    {
      "description": "Renovate recompiles each lockfile on its own and never moves a pin in a parent layer (_base -> _test -> _tools). Before committing, re-run `make reqs` with the chosen versions in every requirements/ directory that is touched or pins those packages at another version. Allowed by allowedCommands in .github/renovate/global-config.json5",
      "matchManagers": [
        "pip-compile"
      ],
      "postUpgradeTasks": {
        "commands": [
          "bash scripts/renovate/resync-lockfiles.bash"
        ],
        "dataFileTemplate": "{{#each upgrades}}{{{depName}}}=={{{newVersion}}}\n{{/each}}",
        "fileFilters": [
          "**/requirements/_*.txt",
          "api/tests/requirements.txt",
          "ci/helpers/requirements/requirements.txt",
          "tests/environment-setup/requirements/requirements.txt"
        ],
        "executionMode": "branch",
        "installTools": {
          "python": {},
          "uv": {}
        }
      }
    },
    {
      "description": "Shared packages: upgrade faster (smaller blast radius)",
      "matchFileNames": [
        "packages/**/requirements/**"
      ],
      "groupName": "packages deps",
      "minimumReleaseAge": "3 days",
      "dependencyDashboardApproval": true,
      "prCreation": "approval",
      "automerge": true
    },
    {
      "description": "Services: upgrade slower / more conservative",
      "matchFileNames": [
        "services/**/requirements/**"
      ],
      "groupName": "services deps",
      "minimumReleaseAge": "14 days",
      "dependencyDashboardApproval": true,
      "prCreation": "approval",
      "automerge": true
    },
    {
      "description": "These requirements.txt are pip-compile outputs; let pip-compile own them (avoid double updates)",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "api/tests/requirements.txt",
        "ci/helpers/requirements/requirements.txt",
        "tests/environment-setup/requirements/requirements.txt"
      ],
      "enabled": false
    },
    {
      "description": "setup.py install_requires reference internal, unpublished simcore-* packages (from packages/) as version-pinned strings (e.g. simcore-sdk>=1.1.0). These never exist on PyPI, so pip_setup lookups always 404; disable the manager entirely",
      "matchManagers": [
        "pip_setup"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "docker images",
      "dependencyDashboardApproval": true,
      "prCreation": "approval",
      "automerge": true
    }
  ]
}
