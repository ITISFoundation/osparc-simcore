{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboardApproval"
  ],
  "dependencyDashboard": true,
  "prCreation": "approval",
  // Renovate never merges: PRs carry the 🤖-automerge label and are queued by Mergify
  // once approved (see .github/mergify.yml), like any other PR
  "automerge": false,
  "branchPrefix": "renovate/",
  "commitMessageSuffix": " [Renovate]",
  // Tools Renovate installs for pip-compile and its post-upgrade task. uv is updated
  // together with requirements/UV_VERSION by the "uv" group below; python is updated
  // by hand with requirements/PYTHON_VERSION
  // (both checked by tests/environment-setup/test_used_{uv,python}.py)
  "constraints": {
    "python": "~=3.14.0",
    "uv": "0.13.0"
  },
  "labels": [
    "t:maintenance",
    "🤖-automerge"
  ],
  // GitHub's Dependabot alerts cover transitive dependencies but briefly vanish while
  // GitHub rescans after a push; OSV covers direct dependencies only, independently
  // of GitHub, and also blocks updates to known-malicious versions
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": true
  },
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "timezone": "Europe/Zurich",
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements/_[^/]+\\.txt$/",
      "/(^|/)api/tests/requirements\\.txt$/",
      "/(^|/)ci/helpers/requirements/requirements\\.txt$/",
      "/(^|/)tests/e2e-playwright/requirements/_[^/]+\\.txt$/",
      "/(^|/)tests/environment-setup/requirements/requirements\\.txt$/"
    ]
  },
  "customManagers": [
    {
      "description": "uv version used by the Makefile, CI and the base images. Read as the PyPI package 'uv' (like the constraints above), so normal and security updates (OSV knows PyPI, not the Docker image) change all of them together",
      "customType": "regex",
      "managerFilePatterns": [
        "/^requirements/UV_VERSION$/"
      ],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "description": "Same uv version in the Dockerfiles (ARG UV_VERSION feeding FROM ghcr.io/astral-sh/uv:${UV_VERSION}), whose image tags follow the PyPI releases",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "ARG UV_VERSION=\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    // any time that day: Renovate runs nightly at 03:17/04:17 Zurich time
    // (see .github/workflows/chore-renovate.yml), so a narrower window can be missed
    "schedule": [
      "on the first day of the month"
    ]
  },
  "packageRules": [
    {
      "description": "pip-compile lockfiles (e.g. _test.txt, _tools.txt) reference _base.txt as a --constraint, so packages only pinned there (not required directly by their own .in file) are classified by Renovate as 'indirect' deps and ignored by default. Force-enable them so they don't silently drift out of sync (e.g. stay on an old, vulnerable version) whenever _base.txt is bumped.",
      "matchManagers": [
        "pip-compile"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Group all pip-compile outputs (_base.txt, _test.txt, _tools.txt, ...) of the same requirements/ directory into a single branch/PR, so they are always updated atomically instead of drifting apart",
      "matchManagers": [
        "pip-compile"
      ],
      "groupName": "{{packageFileDir}}",
      "groupSlug": "{{packageFileDir}}"
    },
    {
      "description": "Renovate recompiles each lockfile on its own and never moves a pin in a parent layer (_base -> _test -> _tools). Before committing, re-run `make reqs` with the chosen versions in every requirements/ directory that is touched or pins those packages at another version. Allowed by allowedCommands in .github/renovate/global-config.json5",
      "matchManagers": [
        "pip-compile"
      ],
      "postUpgradeTasks": {
        "commands": [
          "bash .github/renovate/resync-lockfiles.bash"
        ],
        "dataFileTemplate": "{{#each upgrades}}{{{depName}}}=={{{newVersion}}}\n{{/each}}",
        "fileFilters": [
          "**/requirements/_*.txt",
          "api/tests/requirements.txt",
          "ci/helpers/requirements/requirements.txt",
          "tests/environment-setup/requirements/requirements.txt"
        ],
        "executionMode": "branch",
        "installTools": {
          "python": {},
          "uv": {}
        }
      }
    },
    {
      "description": "Shared packages: upgrade faster (smaller blast radius)",
      "matchFileNames": [
        "packages/**/requirements/**"
      ],
      "groupName": "packages deps",
      "minimumReleaseAge": "3 days",
      "dependencyDashboardApproval": true,
      "prCreation": "approval"
    },
    {
      "description": "Services: upgrade slower / more conservative",
      "matchFileNames": [
        "services/**/requirements/**"
      ],
      "groupName": "services deps",
      "minimumReleaseAge": "14 days",
      "dependencyDashboardApproval": true,
      "prCreation": "approval"
    },
    {
      "description": "These requirements.txt are pip-compile outputs; let pip-compile own them (avoid double updates)",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "api/tests/requirements.txt",
        "ci/helpers/requirements/requirements.txt",
        "tests/environment-setup/requirements/requirements.txt"
      ],
      "enabled": false
    },
    {
      "description": "setup.py install_requires reference internal, unpublished simcore-* packages (from packages/) as version-pinned strings (e.g. simcore-sdk>=1.1.0). These never exist on PyPI, so pip_setup lookups always 404; disable the manager entirely",
      "matchManagers": [
        "pip_setup"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "docker images",
      "dependencyDashboardApproval": true,
      "prCreation": "approval"
    },
    {
      "description": "The uv image in the Dockerfiles is updated through its ARG UV_VERSION (see customManagers), not as a Docker image",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "ghcr.io/astral-sh/uv"
      ],
      "enabled": false
    },
    {
      "description": "uv is pinned in requirements/UV_VERSION, in the Dockerfiles (ARG UV_VERSION) and in the constraints above, which tests/environment-setup/test_used_uv.py requires to match: update them together, once a release has been out for a week (security fixes do not wait)",
      "matchDepNames": [
        "uv"
      ],
      "groupName": "uv",
      "groupSlug": "uv",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Python is upgraded by hand across the whole repository (see requirements/how-to-upgrade-python.md): base images, .python-version, requires-python, actions/setup-python inputs and the constraints above",
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    }
  ]
}
