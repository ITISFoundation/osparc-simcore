{
  // How a PR gets from here to master (labels, CI, who may approve, who merges) is
  // documented in docs/renovate.md
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  // Renovate never merges: Mergify queues its pull requests once approved, like
  // any other pull request (see .github/mergify.yml)
  "automerge": false,
  "branchPrefix": "renovate/",
  "commitMessageSuffix": " [Renovate]",
  // Tools Renovate installs for pip-compile and its post-upgrade task. uv is updated
  // together with requirements/UV_VERSION by the "uv" group below; python is updated
  // by hand with requirements/PYTHON_VERSION
  // (both checked by tests/environment-setup/test_used_{uv,python}.py)
  "constraints": {
    "python": "~=3.14.0",
    "uv": "0.13.6"
  },
  "labels": [
    "t:maintenance"
  ],
  // GitHub's Dependabot alerts cover transitive dependencies but briefly vanish while
  // GitHub rescans after a push; OSV covers direct dependencies only, independently
  // of GitHub, and also blocks updates to known-malicious versions
  "osvVulnerabilityAlerts": true,
  // security PRs are created right away, without approval on the Dependency Dashboard,
  // and ignore the PR limits below
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": false,
    // on top of the labels above (addLabels appends, labels would replace)
    "addLabels": [
      "security"
    ],
    // the newest version instead of the lowest fixed one: Renovate otherwise proposes
    // different versions for lockfiles below and above the fix in the same branch, the
    // PR title shows only one of them, and .github/renovate/resync_lockfiles.py has to
    // pick one. This can be a new major version: the PR still needs two reviews
    "vulnerabilityFixStrategy": "highest"
  },
  // regular PRs: at most 2 new ones per run (Renovate runs nightly, see
  // .github/workflows/chore-renovate.yml) and at most 2 open at a time, so the next
  // ones wait until one of them is merged or closed
  "prHourlyLimit": 2,
  "prConcurrentLimit": 2,
  "timezone": "Europe/Zurich",
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements/_[^/]+\\.txt$/",
      "/(^|/)api/tests/requirements\\.txt$/",
      "/(^|/)ci/helpers/requirements/requirements\\.txt$/",
      "/(^|/)tests/e2e-playwright/requirements/_[^/]+\\.txt$/",
      "/(^|/)tests/environment-setup/requirements/requirements\\.txt$/"
    ]
  },
  // docker-compose: config:recommended ignores **/test/** and **/tests/**, so the fixture
  // compose files under the tests directories were never scanned and fell behind the main
  // stack on image digests (see the partial valkey update of PR #9915, guarded since by
  // services/web/server/tests/unit/isolated/test__consistency.py). Scan them together with
  // the rest, so Renovate moves every file sharing an image in one PR, except the fixtures
  // of the service-integration tests, which pin an old image version on purpose
  "docker-compose": {
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/__fixtures__/**",
      "**/packages/service-integration/tests/data/**"
    ]
  },
  "customManagers": [
    {
      "description": "uv version used by the Makefile, CI and the base images. Read as the PyPI package 'uv' (like the constraints above), so normal and security updates (OSV knows PyPI, not the Docker image) change all of them together",
      "customType": "regex",
      "managerFilePatterns": [
        "/^requirements/UV_VERSION$/"
      ],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "description": "uv version used by Renovate's installed tool, kept in sync with requirements/UV_VERSION",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.renovaterc\\.jsonc$/"
      ],
      "matchStrings": [
        "\"constraints\"\\s*:\\s*\\{[^}]*\"uv\"\\s*:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "description": "Same uv version in the Dockerfiles (ARG UV_VERSION feeding FROM ghcr.io/astral-sh/uv:${UV_VERSION}), whose image tags follow the PyPI releases",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "ARG UV_VERSION=\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "description": "Exact Python version in .python-version, versioned by the official python image tags (the Dockerfiles need the image)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.python-version$/"
      ],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Same exact Python version in PYTHON_VERSION (Dockerfile ARG, Makefiles, scripts) and in literal python image tags",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/",
        "/(^|/)Makefile$/",
        "/\\.(bash|mk)$/"
      ],
      "matchStrings": [
        "PYTHON_VERSION=\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "FROM python:(?<currentValue>\\d+\\.\\d+\\.\\d+)-"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    // re-resolves every package of a requirements directory, with no pin for
    // .github/renovate/resync_lockfiles.py to propagate: only on request
    "dependencyDashboardApproval": true,
    // any time that day: Renovate runs nightly at 03:17/04:17 Zurich time
    // (see .github/workflows/chore-renovate.yml), so a narrower window can be missed
    "schedule": [
      "on the first day of the month"
    ]
  },
  "packageRules": [
    {
      "description": "Deps in .in files have no version specifier, so no range strategy would ever propose an update for them and the lockfiles go stale. update-lockfile raises the pin in the .txt lockfiles to the newest version the .in range allows and never edits the .in files. The post-upgrade resync propagates the pin to the lockfiles that depend on it",
      "matchManagers": [
        "pip-compile"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "One branch/PR per dependency: every lockfile pinning the package moves in the same PR, and the resync below propagates the pin to the directories that constrain it at another layer. Replaces the old grouping per requirements/ directory, which collapsed into two per-area mega-branches",
      "matchManagers": [
        "pip-compile"
      ],
      "groupName": "{{depName}}",
      "groupSlug": "{{depName}}"
    },
    {
      "description": "Renovate recompiles each lockfile on its own and never moves a pin in a parent layer (_base -> _test -> _tools). Before committing, re-run `make reqs` with the chosen versions in every requirements/ directory that is touched or pins those packages at another version. Allowed by allowedCommands in .github/renovate/global-config.json5",
      "matchManagers": [
        "pip-compile"
      ],
      "postUpgradeTasks": {
        "commands": [
          "uv run --script --no-project .github/renovate/resync_lockfiles.py"
        ],
        "dataFileTemplate": "{{#each upgrades}}{{{depName}}}=={{{newVersion}}}\n{{/each}}",
        "fileFilters": [
          "**/requirements/_*.txt",
          "api/tests/requirements.txt",
          "ci/helpers/requirements/requirements.txt",
          "tests/environment-setup/requirements/requirements.txt",
          // the resync's failure report, so a lockfile left on a vulnerable version is visible in the PR and not only in the run log (the script removes it once a resync runs clean)
          "renovate-resync-report.md"
        ],
        "executionMode": "branch",
        "installTools": {
          "python": {},
          "uv": {}
        }
      }
    },
    {
      "description": "Python dependencies: wait two weeks before adopting a release (same cool-down as GitHub Actions and uv)",
      "matchManagers": [
        "pip-compile"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "These requirements.txt are pip-compile outputs; let pip-compile own them (avoid double updates)",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "api/tests/requirements.txt",
        "ci/helpers/requirements/requirements.txt",
        "tests/environment-setup/requirements/requirements.txt"
      ],
      "enabled": false
    },
    {
      "description": "setup.py install_requires reference internal, unpublished simcore-* packages (from packages/) as version-pinned strings (e.g. simcore-sdk>=1.1.0). These never exist on PyPI, so pip_setup lookups always 404; disable the manager entirely",
      "matchManagers": [
        "pip_setup"
      ],
      "enabled": false
    },
    {
      "description": "GitHub Actions: wait two weeks before adopting a release, the cool-down previously enforced by Dependabot's cooldown block (its `github-actions` ecosystem). Security updates skip minimumReleaseAge and land right away",
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Docker images: one PR per image (no grouping, so an update of one image does not block the others) and majors step only one major at a time (e.g. postgres 14 -> 15, never 14 -> 18). Majors still need approval on the Dependency Dashboard (see the major rule below)",
      "matchDatasources": [
        "docker"
      ],
      "maxMajorIncrement": 1
    },
    {
      "description": "Major updates usually need code changes: only on request, by ticking them on the Dependency Dashboard (security fixes excepted, see vulnerabilityAlerts)",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The uv image in the Dockerfiles is updated through its ARG UV_VERSION (see customManagers), not as a Docker image",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "ghcr.io/astral-sh/uv"
      ],
      "enabled": false
    },
    {
      "description": "uv is pinned in requirements/UV_VERSION, in the Dockerfiles (ARG UV_VERSION) and in the constraints above, which tests/environment-setup/test_used_uv.py requires to match: update them together, once a release has been out for two weeks (security fixes do not wait)",
      "matchDepNames": [
        "uv"
      ],
      "groupName": "uv",
      "groupSlug": "uv",
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Python minor/major upgrades are done by hand across the whole repository (see requirements/how-to-upgrade-python.md): base images, .python-version, requires-python, actions/setup-python inputs and the constraints above are never touched by Renovate",
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "...except patch releases of the exact Python version (PYTHON_VERSION, .python-version, python image tags; see customManagers), updated together in one PR: tests/environment-setup/test_used_python.py only compares major.minor, so a partial update would go unnoticed. No minimumReleaseAge: Docker Hub gives the python tags no release date, so they would wait forever",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": true,
      // otherwise Renovate only offers the newest version (a minor one, disabled below)
      // and never the newest patch of the current minor
      "separateMinorPatch": true,
      "groupName": "python",
      "groupSlug": "python"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    }
  ]
}
