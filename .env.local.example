# Clone to .env.local to override .env-devel on this machine. Keys here win: make builds
# .env from .env-devel, then appends .env.local.
#
# .env is regenerated, so edit this file instead. .env.local is git-ignored and survives
# make clean. See docs/env-vars.md.
#
# Only override keys that exist in .env-devel: tests read .env-devel directly, so a
# variable defined only here fails them.
#
# No `export` prefix, and keep a space before any `#`: the test helpers that parse env
# files with ^(\w+)= reject both.

# Internal Docker registry (.env-devel ships placeholders):
# REGISTRY_URL=registry.example.com
# REGISTRY_PATH=registry.example.com/osparc
# REGISTRY_USER=<your user>
# REGISTRY_PW=<your password>
# REGISTRY_AUTH=True
# REGISTRY_SSL=True

# Written by `make local-registry` (unsecured registry on port 5000), removed by
# `make rm-registry`:
# REGISTRY_PATH=registry:5000
# REGISTRY_URL=<this host's ip>:5000
# REGISTRY_AUTH=False
# REGISTRY_SSL=False
# DIRECTOR_REGISTRY_CACHING=False
# CATALOG_BACKGROUND_TASK_REST_TIME=1
