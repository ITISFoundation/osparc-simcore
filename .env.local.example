# Local overrides for .env: clone this file to .env.local and fill in what you need.
#
# make generates .env from .env-devel (the tracked defaults) followed by .env.local, so a
# key set here wins over the default. .env.local is git-ignored and survives make clean;
# .env is regenerated, so editing it does not. See docs/env-vars.md.
#
# Override keys that already exist in .env-devel. A variable introduced only here stays
# invisible to the tests that read .env-devel directly, and they fail on it.

# Docker registry. .env-devel ships placeholders, so a real internal registry needs:
# REGISTRY_URL=registry.example.com
# REGISTRY_PATH=registry.example.com/osparc
# REGISTRY_USER=<your user>
# REGISTRY_PW=<your password>
# REGISTRY_AUTH=True
# REGISTRY_SSL=True

# Written by `make local-registry` (unsecured registry on port 5000), removed by
# `make rm-registry`:
# REGISTRY_PATH=registry:5000
# REGISTRY_URL=<this host's ip>:5000
# REGISTRY_AUTH=False
# REGISTRY_SSL=False
# DIRECTOR_REGISTRY_CACHING=False
# CATALOG_BACKGROUND_TASK_REST_TIME=1

# No `export` prefix, and keep a space before any `#` comment: compose tolerates both,
# the test helpers that parse env files with ^(\w+)= do not.
