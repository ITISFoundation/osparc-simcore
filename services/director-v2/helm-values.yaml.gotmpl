image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/director-v2
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

# entrypoint.sh runs update-ca-certificates and adds scu to the docker socket's group, both need a writable /etc
containerSecurityContext:
  readOnlyRootFilesystem: false

extraVolumes:
  - name: docker-socket
    hostPath:
      path: /var/run/docker.sock
      type: Socket

extraVolumeMounts:
  - name: docker-socket
    mountPath: /var/run/docker.sock

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

env:
  COMPUTATIONAL_BACKEND_DEFAULT_CLUSTER_FILE_LINK_TYPE: {{ requiredEnv "COMPUTATIONAL_BACKEND_DEFAULT_CLUSTER_FILE_LINK_TYPE" | quote }}
  COMPUTATIONAL_BACKEND_DEFAULT_CLUSTER_URL: {{ requiredEnv "COMPUTATIONAL_BACKEND_DEFAULT_CLUSTER_URL" | quote }}
  COMPUTATIONAL_BACKEND_DEFAULT_FILE_LINK_TYPE: {{ requiredEnv "COMPUTATIONAL_BACKEND_DEFAULT_FILE_LINK_TYPE" | quote }}
  COMPUTATIONAL_BACKEND_ON_DEMAND_CLUSTERS_FILE_LINK_TYPE: {{ requiredEnv "COMPUTATIONAL_BACKEND_ON_DEMAND_CLUSTERS_FILE_LINK_TYPE" | quote }}
  COMPUTATIONAL_BACKEND_SCHEDULING_CONCURRENCY: {{ requiredEnv "COMPUTATIONAL_BACKEND_SCHEDULING_CONCURRENCY" | quote }}
  DIRECTOR_HOST: {{ requiredEnv "DIRECTOR_HOST" | quote }}
  DIRECTOR_PORT: {{ requiredEnv "DIRECTOR_PORT" | quote }}
  DIRECTOR_V2_DEV_FEATURES_ENABLED: {{ requiredEnv "DIRECTOR_V2_DEV_FEATURES_ENABLED" | quote }}
  DIRECTOR_V2_DOCKER_HUB_REGISTRY: {{ requiredEnv "DIRECTOR_V2_DOCKER_HUB_REGISTRY" | quote }}
  DIRECTOR_V2_DYNAMIC_SCHEDULER_CLOSE_SERVICES_VIA_FRONTEND_WHEN_CREDITS_LIMIT_REACHED: {{ requiredEnv "DIRECTOR_V2_DYNAMIC_SCHEDULER_CLOSE_SERVICES_VIA_FRONTEND_WHEN_CREDITS_LIMIT_REACHED" | quote }}
  DIRECTOR_V2_DYNAMIC_SCHEDULER_ENABLED: {{ requiredEnv "DIRECTOR_V2_DYNAMIC_SCHEDULER_ENABLED" | quote }}
  DIRECTOR_V2_DYNAMIC_SIDECAR_OSPARC_CUSTOM_DOCKER_PLACEMENT_CONSTRAINTS: {{ requiredEnv "DIRECTOR_V2_DYNAMIC_SIDECAR_OSPARC_CUSTOM_DOCKER_PLACEMENT_CONSTRAINTS" | quote }}
  DIRECTOR_V2_DYNAMIC_SIDECAR_SLEEP_AFTER_CONTAINER_REMOVAL: {{ requiredEnv "DIRECTOR_V2_DYNAMIC_SIDECAR_SLEEP_AFTER_CONTAINER_REMOVAL" | quote }}
  DIRECTOR_V2_GENERIC_RESOURCE_PLACEMENT_CONSTRAINTS_SUBSTITUTIONS: {{ requiredEnv "DIRECTOR_V2_GENERIC_RESOURCE_PLACEMENT_CONSTRAINTS_SUBSTITUTIONS" | quote }}
  DIRECTOR_V2_LOGLEVEL: {{ requiredEnv "DIRECTOR_V2_LOGLEVEL" | quote }}
  DIRECTOR_V2_NODE_PORTS_STORAGE_AUTH: {{ requiredEnv "DIRECTOR_V2_NODE_PORTS_STORAGE_AUTH" | quote }}
  DIRECTOR_V2_PROFILING: {{ requiredEnv "DIRECTOR_V2_PROFILING" | quote }}
  DIRECTOR_V2_SERVICES_CUSTOM_PLACEMENT_CONSTRAINTS: {{ requiredEnv "DIRECTOR_V2_SERVICES_CUSTOM_PLACEMENT_CONSTRAINTS" | quote }}
  DIRECTOR_V2_TRACING: {{ requiredEnv "DIRECTOR_V2_TRACING" | quote }}
  DYNAMIC_SIDECAR_API_SAVE_RESTORE_STATE_TIMEOUT: {{ requiredEnv "DYNAMIC_SIDECAR_API_SAVE_RESTORE_STATE_TIMEOUT" | quote }}
  DYNAMIC_SIDECAR_CUSTOM_LABELS: {{ requiredEnv "DYNAMIC_SIDECAR_CUSTOM_LABELS" | quote }}
  DYNAMIC_SIDECAR_ENABLE_VOLUME_LIMITS: {{ requiredEnv "DYNAMIC_SIDECAR_ENABLE_VOLUME_LIMITS" | quote }}
  DYNAMIC_SIDECAR_ENDPOINT_SPECS_MODE_DNSRR_ENABLED: {{ requiredEnv "DYNAMIC_SIDECAR_ENDPOINT_SPECS_MODE_DNSRR_ENABLED" | quote }}
  DYNAMIC_SIDECAR_IMAGE: {{ requiredEnv "DYNAMIC_SIDECAR_IMAGE" | quote }}
  DYNAMIC_SIDECAR_LOG_LEVEL: {{ requiredEnv "DYNAMIC_SIDECAR_LOG_LEVEL" | quote }}
  DYNAMIC_SIDECAR_PROMETHEUS_MONITORING_NETWORKS: {{ requiredEnv "DYNAMIC_SIDECAR_PROMETHEUS_MONITORING_NETWORKS" | quote }}
  DYNAMIC_SIDECAR_PROMETHEUS_SERVICE_LABELS: {{ requiredEnv "DYNAMIC_SIDECAR_PROMETHEUS_SERVICE_LABELS" | quote }}
  MONITORING_ENABLED: {{ env "MONITORING_ENABLED" | quote }}
  R_CLONE_PROVIDER: {{ requiredEnv "R_CLONE_PROVIDER" | quote }}
  R_CLONE_SIMCORE_SDK_MOUNT_SETTINGS: {{ requiredEnv "R_CLONE_SIMCORE_SDK_MOUNT_SETTINGS" | quote }}
  R_CLONE_SIMCORE_SDK_SYNC_SETTINGS: {{ requiredEnv "R_CLONE_SIMCORE_SDK_SYNC_SETTINGS" | quote }}
  SIMCORE_SERVICES_NETWORK_NAME: {{ requiredEnv "SIMCORE_SERVICES_NETWORK_NAME" | quote }}
  STORAGE_HOST: {{ requiredEnv "STORAGE_HOST" | quote }}
  STORAGE_PORT: {{ requiredEnv "STORAGE_PORT" | quote }}
  SWARM_STACK_NAME: {{ requiredEnv "SWARM_STACK_NAME" | quote }}
  TRAEFIK_SIMCORE_ZONE: {{ requiredEnv "TRAEFIK_SIMCORE_ZONE" | quote }}
  WEBSERVER_HOST: {{ requiredEnv "WB_AUTH_WEBSERVER_HOST" | quote }}
  WEBSERVER_PORT: {{ requiredEnv "WB_AUTH_WEBSERVER_PORT" | quote }}

secretEnv:
  COMPUTATIONAL_BACKEND_DEFAULT_CLUSTER_AUTH: {{ requiredEnv "COMPUTATIONAL_BACKEND_DEFAULT_CLUSTER_AUTH" | quote }}
