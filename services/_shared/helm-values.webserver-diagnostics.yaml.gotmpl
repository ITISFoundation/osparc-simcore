env:
  DIAGNOSTICS_HEALTHCHECK_ENABLED: {{ requiredEnv "DIAGNOSTICS_HEALTHCHECK_ENABLED" | quote }}
  DIAGNOSTICS_MAX_AVG_LATENCY: {{ requiredEnv "DIAGNOSTICS_MAX_AVG_LATENCY" | quote }}
  DIAGNOSTICS_MAX_TASK_DELAY: {{ requiredEnv "DIAGNOSTICS_MAX_TASK_DELAY" | quote }}
  DIAGNOSTICS_SLOW_DURATION_SECS: {{ requiredEnv "DIAGNOSTICS_SLOW_DURATION_SECS" | quote }}
