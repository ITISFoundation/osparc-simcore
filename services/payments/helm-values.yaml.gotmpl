image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/payments
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

env:
  PAYMENTS_ACCESS_TOKEN_EXPIRE_MINUTES: {{ requiredEnv "PAYMENTS_ACCESS_TOKEN_EXPIRE_MINUTES" | quote }}
  PAYMENTS_AUTORECHARGE_DEFAULT_MONTHLY_LIMIT: {{ requiredEnv "PAYMENTS_AUTORECHARGE_DEFAULT_MONTHLY_LIMIT" | quote }}
  PAYMENTS_AUTORECHARGE_DEFAULT_TOP_UP_AMOUNT: {{ requiredEnv "PAYMENTS_AUTORECHARGE_DEFAULT_TOP_UP_AMOUNT" | quote }}
  PAYMENTS_AUTORECHARGE_ENABLED: {{ requiredEnv "PAYMENTS_AUTORECHARGE_ENABLED" | quote }}
  PAYMENTS_AUTORECHARGE_MIN_BALANCE_IN_CREDITS: {{ requiredEnv "PAYMENTS_AUTORECHARGE_MIN_BALANCE_IN_CREDITS" | quote }}
  PAYMENTS_BCC_EMAIL: {{ requiredEnv "PAYMENTS_BCC_EMAIL" | quote }}
  PAYMENTS_GATEWAY_URL: {{ requiredEnv "PAYMENTS_GATEWAY_URL" | quote }}
  PAYMENTS_LOGLEVEL: {{ requiredEnv "PAYMENTS_LOGLEVEL" | quote }}
  PAYMENTS_STRIPE_URL: {{ requiredEnv "PAYMENTS_STRIPE_URL" | quote }}
  PAYMENTS_SWAGGER_API_DOC_ENABLED: {{ requiredEnv "PAYMENTS_SWAGGER_API_DOC_ENABLED" | quote }}
  PAYMENTS_TRACING: {{ requiredEnv "PAYMENTS_TRACING" | quote }}
  PAYMENTS_USERNAME: {{ requiredEnv "PAYMENTS_USERNAME" | quote }}
  RESOURCE_USAGE_TRACKER_HOST: {{ requiredEnv "RESOURCE_USAGE_TRACKER_HOST" | quote }}
  RESOURCE_USAGE_TRACKER_PORT: {{ requiredEnv "RESOURCE_USAGE_TRACKER_PORT" | quote }}

secretEnv:
  PAYMENTS_ACCESS_TOKEN_SECRET_KEY: {{ requiredEnv "PAYMENTS_ACCESS_TOKEN_SECRET_KEY" | quote }}
  PAYMENTS_GATEWAY_API_SECRET: {{ requiredEnv "PAYMENTS_GATEWAY_API_SECRET" | quote }}
  PAYMENTS_PASSWORD: {{ requiredEnv "PAYMENTS_PASSWORD" | quote }}
  PAYMENTS_STRIPE_API_SECRET: {{ requiredEnv "PAYMENTS_STRIPE_API_SECRET" | quote }}
