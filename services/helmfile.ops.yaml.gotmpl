helmDefaults:
  # wait for all resources to be ready before marking the release as successful
  # this makes sure that releases are properly installed before continuing with
  # dependent (via `needs`) releases. Read more via `helm install --help`
  wait: true
  waitForJobs: true
  timeout: 600

  # avoid errors on first installation
  # passes --disable-validation to helm 3 diff plugin
  disableValidation: true

repositories:
  - name: headlamp
    url: https://kubernetes-sigs.github.io/headlamp/
  - name: rustfs
    url: https://charts.rustfs.com

releases:
  - name: adminer
    namespace: ops
    createNamespace: true
    chart: ../charts/ops-local/adminer

  - name: flower
    namespace: ops
    createNamespace: true
    chart: ../charts/ops-local/flower
    values:
      - user: {{ requiredEnv "RABBIT_USER" | quote }}
        password: {{ requiredEnv "RABBIT_PASSWORD" | quote }}

  - name: mailpit
    namespace: ops
    createNamespace: true
    chart: ../charts/ops-local/mailpit

  - name: postgres
    namespace: ops
    createNamespace: true
    chart: ../charts/ops-local/postgres
    values:
      - db: {{ requiredEnv "POSTGRES_DB" | quote }}
        user: {{ requiredEnv "POSTGRES_USER" | quote }}
        password: {{ requiredEnv "POSTGRES_PASSWORD" | quote }}

  - name: redis
    namespace: ops
    createNamespace: true
    chart: ../charts/ops-local/redis
    values:
      - password: {{ requiredEnv "REDIS_PASSWORD" | quote }}

  - name: rabbit
    namespace: ops
    createNamespace: true
    chart: ../charts/ops-local/rabbit
    values:
      - user: {{ requiredEnv "RABBIT_USER" | quote }}
        password: {{ requiredEnv "RABBIT_PASSWORD" | quote }}

  - name: rustfs
    namespace: ops
    createNamespace: true
    chart: rustfs/rustfs
    version: 1.0.4
    values:
      - mode:
          standalone:
            enabled: true
          distributed:
            enabled: false
        replicaCount: 1
        ingress:
          enabled: false
        service:
          type: NodePort
        storageclass:
          name: standard
          dataStorageSize: 10Gi
        secret:
          rustfs:
            access_key: {{ requiredEnv "S3_ACCESS_KEY" | quote }}
            secret_key: {{ requiredEnv "S3_SECRET_KEY" | quote }}

  - name: headlamp # Portainer alternative for Kubernetes
    namespace: ops
    createNamespace: true
    chart: headlamp/headlamp
    version: 0.46.0
    values:
      - service:
          type: NodePort
          nodePort: 30080
        config:
          unsafeUseServiceAccountToken: true # access ui without password/token
