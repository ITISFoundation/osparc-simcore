environments:
  default:
    values:
      - opsNamespace: ops
      - postgresHost: postgres.ops.svc.cluster.local
---
helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600

  # avoid helm diff errors on 1st installation
  disableValidation: true

releases:
  - name: migration
    namespace: simcore
    createNamespace: true
    chart: ../charts/simcore-service
    values:
      - migration/helm-values.yaml.gotmpl
