{{- $namespace := "simcore" -}}

helmDefaults:
  # wait for release to finish before continuing
  # needed if one relies on the other
  wait: true
  waitForJobs: true # extend for jobs that belong to releases
  timeout: 600

  # helm diff: avoid errors on 1st installation
  disableValidation: true

templates:
  simcore-service:
    namespace: {{ $namespace }}
    createNamespace: true
    chart: ../charts/simcore-service
    values:
      - "{{`{{ .Release.Name }}`}}/helm-values.yaml.gotmpl"

releases:
  - name: catalog
    inherit:
      - template: simcore-service
    needs:
      - {{ $namespace }}/director

  - name: datcore-adapter
    inherit:
      - template: simcore-service

  - name: director
    inherit:
      - template: simcore-service

  # no needs on webserver: webserver needs director-v2, that would be a cycle
  - name: director-v2
    inherit:
      - template: simcore-service
    needs:
      - {{ $namespace }}/catalog
      - {{ $namespace }}/director
      - {{ $namespace }}/resource-usage-tracker
      - {{ $namespace }}/storage

  - name: docker-api-proxy
    inherit:
      - template: simcore-service

  - name: invitations
    inherit:
      - template: simcore-service

  - name: migration
    inherit:
      - template: simcore-service

  - name: notifications
    inherit:
      - template: simcore-service

  - name: payments
    inherit:
      - template: simcore-service
    needs:
      - {{ $namespace }}/resource-usage-tracker

  - name: resource-usage-tracker
    inherit:
      - template: simcore-service

  - name: static-webserver
    inherit:
      - template: simcore-service

  - name: storage
    inherit:
      - template: simcore-service
    needs:
      - {{ $namespace }}/datcore-adapter

  # celery workers of storage: no own service folder, so no inherit (its values path
  # would resolve to sto-worker/helm-values.yaml.gotmpl); later files win
  - name: sto-worker
    namespace: {{ $namespace }}
    createNamespace: true
    chart: ../charts/simcore-service
    needs:
      - {{ $namespace }}/storage
    values:
      - storage/helm-values.yaml.gotmpl
      - storage/helm-values.sto-worker.yaml.gotmpl

  - name: sto-worker-cpu-bound
    namespace: {{ $namespace }}
    createNamespace: true
    chart: ../charts/simcore-service
    needs:
      - {{ $namespace }}/storage
    values:
      - storage/helm-values.yaml.gotmpl
      - storage/helm-values.sto-worker-cpu-bound.yaml.gotmpl

  - name: wb-garbage-collector
    namespace: {{ $namespace }}
    createNamespace: true
    chart: ../charts/simcore-service
    needs:
      - {{ $namespace }}/director-v2
      - {{ $namespace }}/resource-usage-tracker
      - {{ $namespace }}/storage
    values:
      - web/helm-values.wb-garbage-collector.yaml.gotmpl

  - name: webserver
    namespace: {{ $namespace }}
    createNamespace: true
    chart: ../charts/simcore-service
    needs:
      - {{ $namespace }}/catalog
      - {{ $namespace }}/director-v2
      - {{ $namespace }}/invitations
      - {{ $namespace }}/payments
      - {{ $namespace }}/resource-usage-tracker
      - {{ $namespace }}/storage
    values:
      - web/helm-values.webserver.yaml.gotmpl
