helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600

  # avoid helm diff errors on 1st installation
  disableValidation: true

releases:
  - name: datcore-adapter
    namespace: simcore
    createNamespace: true
    chart: ../charts/simcore-service
    values:
      - datcore-adapter/helm-values.yaml.gotmpl

  - name: invitations
    namespace: simcore
    createNamespace: true
    chart: ../charts/simcore-service
    values:
      - invitations/helm-values.yaml.gotmpl

  - name: migration
    namespace: simcore
    createNamespace: true
    chart: ../charts/simcore-service
    values:
      - migration/helm-values.yaml.gotmpl

  - name: notifications
    namespace: simcore
    createNamespace: true
    chart: ../charts/simcore-service
    values:
      - notifications/helm-values.yaml.gotmpl

  - name: static-webserver
    namespace: simcore
    createNamespace: true
    chart: ../charts/simcore-service
    values:
      - static-webserver/helm-values.yaml.gotmpl
