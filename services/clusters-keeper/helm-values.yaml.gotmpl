image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/clusters-keeper
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

# entrypoint.sh runs update-ca-certificates, which needs a writable /etc
containerSecurityContext:
  readOnlyRootFilesystem: false

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

env:
  CLUSTERS_KEEPER_COMPUTATIONAL_BACKEND_DEFAULT_CLUSTER_AUTH: {{ requiredEnv "CLUSTERS_KEEPER_COMPUTATIONAL_BACKEND_DEFAULT_CLUSTER_AUTH" | quote }}
  CLUSTERS_KEEPER_COMPUTATIONAL_BACKEND_DOCKER_IMAGE_TAG: {{ requiredEnv "CLUSTERS_KEEPER_COMPUTATIONAL_BACKEND_DOCKER_IMAGE_TAG" | quote }}
  CLUSTERS_KEEPER_DASK_NPROCS: {{ requiredEnv "CLUSTERS_KEEPER_DASK_NPROCS" | quote }}
  CLUSTERS_KEEPER_DASK_NTHREADS: {{ requiredEnv "CLUSTERS_KEEPER_DASK_NTHREADS" | quote }}
  CLUSTERS_KEEPER_DASK_NTHREADS_MULTIPLIER: {{ requiredEnv "CLUSTERS_KEEPER_DASK_NTHREADS_MULTIPLIER" | quote }}
  CLUSTERS_KEEPER_DASK_SIDECAR_KMS: {{ requiredEnv "CLUSTERS_KEEPER_DASK_SIDECAR_KMS" | quote }}
  CLUSTERS_KEEPER_DASK_WORKER_SATURATION: {{ requiredEnv "CLUSTERS_KEEPER_DASK_WORKER_SATURATION" | quote }}
  CLUSTERS_KEEPER_EC2_ACCESS: {{ requiredEnv "CLUSTERS_KEEPER_EC2_ACCESS" | quote }}
  CLUSTERS_KEEPER_EC2_ACCESS_KEY_ID: {{ env "CLUSTERS_KEEPER_EC2_ACCESS_KEY_ID" | quote }}
  CLUSTERS_KEEPER_EC2_ENDPOINT: {{ env "CLUSTERS_KEEPER_EC2_ENDPOINT" | quote }}
  CLUSTERS_KEEPER_EC2_INSTANCES_PREFIX: {{ env "CLUSTERS_KEEPER_EC2_INSTANCES_PREFIX" | quote }}
  CLUSTERS_KEEPER_EC2_REGION_NAME: {{ env "CLUSTERS_KEEPER_EC2_REGION_NAME" | quote }}
  CLUSTERS_KEEPER_LOGLEVEL: {{ requiredEnv "CLUSTERS_KEEPER_LOGLEVEL" | quote }}
  CLUSTERS_KEEPER_MAX_MISSED_HEARTBEATS_BEFORE_CLUSTER_TERMINATION: {{ requiredEnv "CLUSTERS_KEEPER_MAX_MISSED_HEARTBEATS_BEFORE_CLUSTER_TERMINATION" | quote }}
  CLUSTERS_KEEPER_PRIMARY_EC2_INSTANCES: {{ requiredEnv "CLUSTERS_KEEPER_PRIMARY_EC2_INSTANCES" | quote }}
  CLUSTERS_KEEPER_SSM_ACCESS: {{ requiredEnv "CLUSTERS_KEEPER_SSM_ACCESS" | quote }}
  CLUSTERS_KEEPER_SSM_ACCESS_KEY_ID: {{ env "CLUSTERS_KEEPER_SSM_ACCESS_KEY_ID" | quote }}
  CLUSTERS_KEEPER_SSM_ENDPOINT: {{ env "CLUSTERS_KEEPER_SSM_ENDPOINT" | quote }}
  CLUSTERS_KEEPER_SSM_REGION_NAME: {{ env "CLUSTERS_KEEPER_SSM_REGION_NAME" | quote }}
  CLUSTERS_KEEPER_TASK_INTERVAL: {{ requiredEnv "CLUSTERS_KEEPER_TASK_INTERVAL" | quote }}
  CLUSTERS_KEEPER_TRACING: {{ requiredEnv "CLUSTERS_KEEPER_TRACING" | quote }}
  CLUSTERS_KEEPER_WORKERS_EC2_INSTANCES: {{ requiredEnv "CLUSTERS_KEEPER_WORKERS_EC2_INSTANCES" | quote }}
  PRIMARY_EC2_INSTANCES_ALLOWED_TYPES: {{ env "PRIMARY_EC2_INSTANCES_ALLOWED_TYPES" | quote }}
  PRIMARY_EC2_INSTANCES_ATTACHED_IAM_PROFILE: {{ env "PRIMARY_EC2_INSTANCES_ATTACHED_IAM_PROFILE" | quote }}
  PRIMARY_EC2_INSTANCES_CUSTOM_TAGS: {{ env "PRIMARY_EC2_INSTANCES_CUSTOM_TAGS" | quote }}
  PRIMARY_EC2_INSTANCES_DOCKER_DEFAULT_ADDRESS_POOL: {{ env "PRIMARY_EC2_INSTANCES_DOCKER_DEFAULT_ADDRESS_POOL" | quote }}
  PRIMARY_EC2_INSTANCES_KEY_NAME: {{ env "PRIMARY_EC2_INSTANCES_KEY_NAME" | quote }}
  PRIMARY_EC2_INSTANCES_MAX_INSTANCES: {{ env "PRIMARY_EC2_INSTANCES_MAX_INSTANCES" | quote }}
  PRIMARY_EC2_INSTANCES_MAX_START_TIME: {{ env "PRIMARY_EC2_INSTANCES_MAX_START_TIME" | quote }}
  PRIMARY_EC2_INSTANCES_PROMETHEUS_USERNAME: {{ env "PRIMARY_EC2_INSTANCES_PROMETHEUS_USERNAME" | quote }}
  PRIMARY_EC2_INSTANCES_RABBIT: {{ env "PRIMARY_EC2_INSTANCES_RABBIT" | quote }}
  PRIMARY_EC2_INSTANCES_SECURITY_GROUP_IDS: {{ env "PRIMARY_EC2_INSTANCES_SECURITY_GROUP_IDS" | quote }}
  PRIMARY_EC2_INSTANCES_SSM_TLS_DASK_CA: {{ env "PRIMARY_EC2_INSTANCES_SSM_TLS_DASK_CA" | quote }}
  PRIMARY_EC2_INSTANCES_SSM_TLS_DASK_CERT: {{ env "PRIMARY_EC2_INSTANCES_SSM_TLS_DASK_CERT" | quote }}
  PRIMARY_EC2_INSTANCES_SSM_TLS_DASK_KEY: {{ env "PRIMARY_EC2_INSTANCES_SSM_TLS_DASK_KEY" | quote }}
  PRIMARY_EC2_INSTANCES_SUBNET_IDS: {{ env "PRIMARY_EC2_INSTANCES_SUBNET_IDS" | quote }}
  SWARM_STACK_NAME: {{ requiredEnv "SWARM_STACK_NAME" | quote }}
  WORKERS_EC2_INSTANCES_ALLOWED_TYPES: {{ env "WORKERS_EC2_INSTANCES_ALLOWED_TYPES" | quote }}
  WORKERS_EC2_INSTANCES_COLD_START_DOCKER_IMAGES_PRE_PULLING: {{ env "WORKERS_EC2_INSTANCES_COLD_START_DOCKER_IMAGES_PRE_PULLING" | quote }}
  WORKERS_EC2_INSTANCES_CUSTOM_TAGS: {{ env "WORKERS_EC2_INSTANCES_CUSTOM_TAGS" | quote }}
  WORKERS_EC2_INSTANCES_KEY_NAME: {{ env "WORKERS_EC2_INSTANCES_KEY_NAME" | quote }}
  WORKERS_EC2_INSTANCES_MAX_INSTANCES: {{ env "WORKERS_EC2_INSTANCES_MAX_INSTANCES" | quote }}
  WORKERS_EC2_INSTANCES_MAX_START_TIME: {{ env "WORKERS_EC2_INSTANCES_MAX_START_TIME" | quote }}
  WORKERS_EC2_INSTANCES_SECURITY_GROUP_IDS: {{ env "WORKERS_EC2_INSTANCES_SECURITY_GROUP_IDS" | quote }}
  WORKERS_EC2_INSTANCES_SUBNET_IDS: {{ env "WORKERS_EC2_INSTANCES_SUBNET_IDS" | quote }}
  WORKERS_EC2_INSTANCES_TIME_BEFORE_DRAINING: {{ env "WORKERS_EC2_INSTANCES_TIME_BEFORE_DRAINING" | quote }}
  WORKERS_EC2_INSTANCES_TIME_BEFORE_TERMINATION: {{ env "WORKERS_EC2_INSTANCES_TIME_BEFORE_TERMINATION" | quote }}

secretEnv:
  CLUSTERS_KEEPER_EC2_SECRET_ACCESS_KEY: {{ env "CLUSTERS_KEEPER_EC2_SECRET_ACCESS_KEY" | quote }}
  CLUSTERS_KEEPER_SSM_SECRET_ACCESS_KEY: {{ env "CLUSTERS_KEEPER_SSM_SECRET_ACCESS_KEY" | quote }}
  PRIMARY_EC2_INSTANCES_PROMETHEUS_PASSWORD: {{ env "PRIMARY_EC2_INSTANCES_PROMETHEUS_PASSWORD" | quote }}
