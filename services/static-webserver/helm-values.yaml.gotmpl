image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/static-webserver
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

# image has no gosu entrypoint and runs non-root, so do not start it as root
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 8004
  runAsGroup: 8004

containerSecurityContext:
  capabilities:
    add: []

env:
  SERVER_HOST: "0.0.0.0"
  SERVER_LOG_LEVEL: "error"
  SERVER_PORT: "8000"
  SERVER_ROOT: "/static-content"

ingresses:
  - annotations:
      traefik.ingress.kubernetes.io/router.entrypoints: web
      traefik.ingress.kubernetes.io/router.priority: "6"
      traefik.ingress.kubernetes.io/router.middlewares: {{ .Release.Namespace }}-gzip@kubernetescrd,{{ .Release.Namespace }}-static-webserver-retry@kubernetescrd
    paths:
      {{- range list "osparc" "s4l" "s4llite" "s4lacad" "s4lengine" "s4ldesktop" "s4ldesktopacad" "tis" "tiplite" "transpiled" "resource" }}
      - path: /{{ . }}
        pathType: Exact
      - path: /{{ . }}/
        pathType: Prefix
      {{- end }}

extraObjects:
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: static-webserver-retry
    spec:
      retry:
        attempts: 2

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi
