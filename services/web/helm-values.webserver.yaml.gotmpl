image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/webserver
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

# entrypoint.sh runs update-ca-certificates, which needs a writable /etc
containerSecurityContext:
  readOnlyRootFilesystem: false

# gunicorn binds 8080 (services/web/server/docker/boot.sh)
containerPort: {{ requiredEnv "WEBSERVER_PORT" | quote }}
service:
  port: {{ requiredEnv "WEBSERVER_PORT" | quote }}

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

env:
  AIODEBUG_SLOW_DURATION_SECS: {{ requiredEnv "AIODEBUG_SLOW_DURATION_SECS" | quote }}
  GUNICORN_CMD_ARGS: {{ requiredEnv "WEBSERVER_GUNICORN_CMD_ARGS" | quote }}
  INVITATIONS_LOGLEVEL: {{ requiredEnv "INVITATIONS_LOGLEVEL" | quote }}
  LICENSES_ITIS_VIP_API_URL: {{ requiredEnv "LICENSES_ITIS_VIP_API_URL" | quote }}
  LICENSES_ITIS_VIP_CATEGORIES: {{ requiredEnv "LICENSES_ITIS_VIP_CATEGORIES" | quote }}
  LICENSES_ITIS_VIP_SYNCER_ENABLED: {{ requiredEnv "LICENSES_ITIS_VIP_SYNCER_ENABLED" | quote }}
  LICENSES_ITIS_VIP_SYNCER_PERIODICITY: {{ requiredEnv "LICENSES_ITIS_VIP_SYNCER_PERIODICITY" | quote }}
  LICENSES_SPEAG_PHANTOMS_API_URL: {{ requiredEnv "LICENSES_SPEAG_PHANTOMS_API_URL" | quote }}
  LICENSES_SPEAG_PHANTOMS_CATEGORIES: {{ requiredEnv "LICENSES_SPEAG_PHANTOMS_CATEGORIES" | quote }}
  LOGIN_2FA_CODE_EXPIRATION_SEC: {{ requiredEnv "LOGIN_2FA_CODE_EXPIRATION_SEC" | quote }}
  LOGIN_2FA_REQUIRED: {{ requiredEnv "LOGIN_2FA_REQUIRED" | quote }}
  LOGIN_ACCOUNT_DELETION_RETENTION_DAYS: {{ requiredEnv "LOGIN_ACCOUNT_DELETION_RETENTION_DAYS" | quote }}
  LOGIN_REGISTRATION_INVITATION_REQUIRED: {{ requiredEnv "LOGIN_REGISTRATION_INVITATION_REQUIRED" | quote }}
  LONG_RUNNING_TASKS_NAMESPACE_SUFFIX: "wb"
  PAYMENTS_AUTORECHARGE_DEFAULT_MONTHLY_LIMIT: {{ requiredEnv "PAYMENTS_AUTORECHARGE_DEFAULT_MONTHLY_LIMIT" | quote }}
  PAYMENTS_AUTORECHARGE_DEFAULT_TOP_UP_AMOUNT: {{ requiredEnv "PAYMENTS_AUTORECHARGE_DEFAULT_TOP_UP_AMOUNT" | quote }}
  PAYMENTS_AUTORECHARGE_MIN_BALANCE_IN_CREDITS: {{ requiredEnv "PAYMENTS_AUTORECHARGE_MIN_BALANCE_IN_CREDITS" | quote }}
  PAYMENTS_FAKE_COMPLETION: {{ requiredEnv "PAYMENTS_FAKE_COMPLETION" | quote }}
  PAYMENTS_FAKE_COMPLETION_DELAY_SEC: {{ requiredEnv "PAYMENTS_FAKE_COMPLETION_DELAY_SEC" | quote }}
  PAYMENTS_FAKE_GATEWAY_URL: {{ requiredEnv "PAYMENTS_GATEWAY_URL" | quote }}
  PROJECTS_INACTIVITY_INTERVAL: {{ requiredEnv "PROJECTS_INACTIVITY_INTERVAL" | quote }}
  PROJECTS_MAX_COPY_SIZE_BYTES: {{ requiredEnv "PROJECTS_MAX_COPY_SIZE_BYTES" | quote }}
  PROJECTS_MAX_NUM_RUNNING_DYNAMIC_NODES: {{ requiredEnv "PROJECTS_MAX_NUM_RUNNING_DYNAMIC_NODES" | quote }}
  PROMETHEUS_API_VERSION: {{ requiredEnv "WEBSERVER_PROMETHEUS_API_VERSION" | quote }}
  PROMETHEUS_URL: {{ requiredEnv "WEBSERVER_PROMETHEUS_URL" | quote }}
  RESOURCE_MANAGER_RESOURCE_TTL_S: {{ requiredEnv "RESOURCE_MANAGER_RESOURCE_TTL_S" | quote }}
  REST_SWAGGER_API_DOC_ENABLED: {{ requiredEnv "REST_SWAGGER_API_DOC_ENABLED" | quote }}
  SCICRUNCH_API_BASE_URL: {{ requiredEnv "SCICRUNCH_API_BASE_URL" | quote }}
  SESSION_COOKIE_HTTPONLY: {{ requiredEnv "SESSION_COOKIE_HTTPONLY" | quote }}
  SESSION_COOKIE_MAX_AGE: {{ requiredEnv "SESSION_COOKIE_MAX_AGE" | quote }}
  SESSION_COOKIE_SAMESITE: {{ requiredEnv "SESSION_COOKIE_SAMESITE" | quote }}
  SESSION_COOKIE_SECURE: {{ requiredEnv "SESSION_COOKIE_SECURE" | quote }}
  SIMCORE_VCS_RELEASE_TAG: {{ requiredEnv "SIMCORE_VCS_RELEASE_TAG" | quote }}
  STUDIES_ACCESS_ANONYMOUS_ALLOWED: {{ requiredEnv "STUDIES_ACCESS_ANONYMOUS_ALLOWED" | quote }}
  STUDIES_DEFAULT_SERVICE_THUMBNAIL: {{ requiredEnv "STUDIES_DEFAULT_SERVICE_THUMBNAIL" | quote }}
  SWARM_STACK_NAME: {{ requiredEnv "SWARM_STACK_NAME" | quote }}
  TRASH_RETENTION_DAYS: {{ requiredEnv "TRASH_RETENTION_DAYS" | quote }}
  TWILIO_ACCOUNT_SID: {{ requiredEnv "TWILIO_ACCOUNT_SID" | quote }}
  TWILIO_COUNTRY_CODES_W_ALPHANUMERIC_SID_SUPPORT: {{ requiredEnv "TWILIO_COUNTRY_CODES_W_ALPHANUMERIC_SID_SUPPORT" | quote }}
  WEBSERVER_ACTIVITY: {{ requiredEnv "WEBSERVER_ACTIVITY" | quote }}
  WEBSERVER_ANNOUNCEMENTS: {{ requiredEnv "WEBSERVER_ANNOUNCEMENTS" | quote }}
  WEBSERVER_CATALOG: {{ requiredEnv "WEBSERVER_CATALOG" | quote }}
  WEBSERVER_CHATBOT: {{ requiredEnv "WEBSERVER_CHATBOT" | quote }}
  WEBSERVER_CONVERSATIONS: {{ env "WEBSERVER_CONVERSATIONS" | default "true" | quote }}
  WEBSERVER_CREDIT_COMPUTATION_ENABLED: {{ requiredEnv "WEBSERVER_CREDIT_COMPUTATION_ENABLED" | quote }}
  WEBSERVER_DB_LISTENER: {{ requiredEnv "WEBSERVER_DB_LISTENER" | quote }}
  WEBSERVER_DEV_FEATURES_ENABLED: {{ requiredEnv "WEBSERVER_DEV_FEATURES_ENABLED" | quote }}
  WEBSERVER_DIAGNOSTICS: {{ requiredEnv "WEBSERVER_DIAGNOSTICS" | quote }}
  WEBSERVER_EXPORTER: {{ requiredEnv "WEBSERVER_EXPORTER" | quote }}
  WEBSERVER_FOGBUGZ: {{ requiredEnv "WEBSERVER_FOGBUGZ" | quote }}
  WEBSERVER_FOLDERS: {{ requiredEnv "WEBSERVER_FOLDERS" | quote }}
  WEBSERVER_FRONTEND: {{ requiredEnv "WEBSERVER_FRONTEND" | quote }}
  WEBSERVER_FUNCTIONS: {{ requiredEnv "WEBSERVER_FUNCTIONS" | quote }}
  WEBSERVER_GARBAGE_COLLECTOR: {{ requiredEnv "WEBSERVER_GARBAGE_COLLECTOR" | quote }}
  WEBSERVER_GROUPS: {{ requiredEnv "WEBSERVER_GROUPS" | quote }}
  WEBSERVER_HOST: {{ requiredEnv "WEBSERVER_HOST" | quote }}
  WEBSERVER_LICENSES: {{ requiredEnv "WEBSERVER_LICENSES" | quote }}
  WEBSERVER_LOCALIZED_MESSAGES_ENABLED: {{ requiredEnv "WEBSERVER_LOCALIZED_MESSAGES_ENABLED" | quote }}
  WEBSERVER_LOGIN: {{ requiredEnv "WEBSERVER_LOGIN" | quote }}
  WEBSERVER_LOGLEVEL: {{ requiredEnv "WEBSERVER_LOGLEVEL" | quote }}
  WEBSERVER_LOG_FILTER_MAPPING: {{ requiredEnv "LOG_FILTER_MAPPING" | quote }}
  WEBSERVER_LOG_FORMAT_LOCAL_DEV_ENABLED: {{ requiredEnv "LOG_FORMAT_LOCAL_DEV_ENABLED" | quote }}
  WEBSERVER_NOTIFICATIONS: {{ requiredEnv "WEBSERVER_NOTIFICATIONS" | quote }}
  WEBSERVER_PAYMENTS: {{ requiredEnv "WEBSERVER_PAYMENTS" | quote }}
  WEBSERVER_PORT: {{ requiredEnv "WEBSERVER_PORT" | quote }}
  WEBSERVER_PRODUCTS: {{ requiredEnv "WEBSERVER_PRODUCTS" | quote }}
  WEBSERVER_PROFILING: {{ requiredEnv "WEBSERVER_PROFILING" | quote }}
  WEBSERVER_PROJECTS: {{ requiredEnv "WEBSERVER_PROJECTS" | quote }}
  WEBSERVER_REALTIME_COLLABORATION: {{ requiredEnv "WEBSERVER_REALTIME_COLLABORATION" | quote }}
  WEBSERVER_RPC_NAMESPACE: {{ env "WEBSERVER_RPC_NAMESPACE" | default "webserver" | quote }}
  WEBSERVER_SCICRUNCH: {{ requiredEnv "WEBSERVER_SCICRUNCH" | quote }}
  WEBSERVER_SOCKETIO: {{ requiredEnv "WEBSERVER_SOCKETIO" | quote }}
  WEBSERVER_STATICWEB: {{ requiredEnv "WEBSERVER_STATICWEB" | quote }}
  WEBSERVER_STUDIES_DISPATCHER: {{ requiredEnv "WEBSERVER_STUDIES_DISPATCHER" | quote }}
  WEBSERVER_TAGS: {{ requiredEnv "WEBSERVER_TAGS" | quote }}
  WEBSERVER_TRACING: {{ requiredEnv "WEBSERVER_TRACING" | quote }}
  WEBSERVER_USERS: {{ requiredEnv "WEBSERVER_USERS" | quote }}

secretEnv:
  SCICRUNCH_API_KEY: {{ requiredEnv "SCICRUNCH_API_KEY" | quote }}
  SESSION_SECRET_KEY: {{ requiredEnv "WEBSERVER_SESSION_SECRET_KEY" | quote }}
  TWILIO_AUTH_TOKEN: {{ requiredEnv "TWILIO_AUTH_TOKEN" | quote }}

# the image's HEALTHCHECK probes /v0/health
probes:
  startup:
    httpGet:
      path: /v0/health
  readiness:
    httpGet:
      path: /v0/health
  liveness:
    httpGet:
      path: /v0/health

ingresses:
  - annotations:
      traefik.ingress.kubernetes.io/router.entrypoints: web
      traefik.ingress.kubernetes.io/router.priority: "6"
      traefik.ingress.kubernetes.io/router.pathmatcher: PathRegexp
      traefik.ingress.kubernetes.io/router.middlewares: {{ .Release.Namespace }}-gzip@kubernetescrd,{{ .Release.Namespace }}-sslheader@kubernetescrd,{{ .Release.Namespace }}-webserver-retry@kubernetescrd
    paths:
      {{- range list
        "/"
        "/v0"
        "/socket.io/"
        "/static-frontend-data.json"
        "/view"
        "/#/view"
        "/#/error"
      }}
      - path: {{ . | quote }}
        pathType: Exact
      {{- end }}
      - path: /v0/
        pathType: Prefix
      - path: '/study/(?P<study_uuid>\b[0-9a-f]{8}\b-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-\b[0-9a-f]{12}\b)'
        pathType: ImplementationSpecific
  # above the webserver router (6), below the dynamic service proxies
  - nameSuffix: sticky
    serviceName: {{ .Release.Name }}-sticky
    annotations:
      traefik.ingress.kubernetes.io/router.entrypoints: web
      traefik.ingress.kubernetes.io/router.priority: "8"
      traefik.ingress.kubernetes.io/router.pathmatcher: PathRegexp
      traefik.ingress.kubernetes.io/router.middlewares: {{ .Release.Namespace }}-gzip@kubernetescrd,{{ .Release.Namespace }}-sslheader@kubernetescrd,{{ .Release.Namespace }}-webserver-retry@kubernetescrd
    paths:
      - path: /v0/projects
        pathType: Exact
      - path: /v0/projects:clone
        pathType: Exact
      {{- range list
        "/v0/projects/[0-9a-fA-F-]+/nodes/[0-9a-fA-F-]+:stop"
        "/v0/projects/[0-9a-fA-F-]+/nodes/[0-9a-fA-F-]+:open"
        "/v0/projects/[0-9a-fA-F-]+/nodes/[0-9a-fA-F-]+:close"
        "/v0/storage/locations/[0-9]+/paths/.+:size"
        "/v0/storage/locations/[0-9]+/-/paths:batchDelete"
        "/v0/storage/locations/[0-9]+:export-data"
        "/v0/tasks-legacy/.+"
      }}
      - path: {{ . | squote }}
        pathType: ImplementationSpecific
      {{- end }}

extraObjects:
  # on a websocket upgrade Traefik sends X-Forwarded-Proto: ws, from which
  # socket.io derives ws://<host> as the only accepted origin and rejects the
  # browser's http:// Origin with 400
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: sslheader
    spec:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: http
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: webserver-retry
    spec:
      retry:
        attempts: 2
  # sticky sessions only for the webserver-sticky Ingress, see
  # https://github.com/ITISFoundation/osparc-simcore/pull/4180; Traefik reads
  # stickiness from the backend Service, hence a second Service on the same pods
  - apiVersion: v1
    kind: Service
    metadata:
      name: {{ .Release.Name }}-sticky
      annotations:
        traefik.ingress.kubernetes.io/service.sticky.cookie: "true"
        traefik.ingress.kubernetes.io/service.sticky.cookie.secure: "true"
        traefik.ingress.kubernetes.io/service.sticky.cookie.httponly: "true"
        traefik.ingress.kubernetes.io/service.sticky.cookie.samesite: lax
    spec:
      selector:
        app.kubernetes.io/name: {{ .Release.Name }}
        app.kubernetes.io/instance: {{ .Release.Name }}
      ports:
        - name: http
          port: {{ requiredEnv "WEBSERVER_PORT" }}
          targetPort: http
