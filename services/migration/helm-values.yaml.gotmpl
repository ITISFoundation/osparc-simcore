image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/migration
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

{{- $doneMarkFile := "/tmp/migration.done" }}

# image has no gosu entrypoint and runs non-root, so do not start it as root
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 8004
  runAsGroup: 8004

containerSecurityContext:
  capabilities:
    add: []

service:
  enabled: false

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

env:
  HOME: "/tmp"
  SC_DONE_MARK_FILE: {{ $doneMarkFile | quote }}

probes:
  startup:
    httpGet: null
    exec:
      command: ["/bin/sh", "-c", "test -f {{ $doneMarkFile }}"]
    periodSeconds: 5
    timeoutSeconds: 5
    failureThreshold: 100
  readiness:
    httpGet: null
    exec:
      command: ["/bin/sh", "-c", "test -f {{ $doneMarkFile }}"]
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 3
  liveness: null
