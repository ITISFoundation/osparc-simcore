image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/migration
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

# image has no gosu entrypoint and runs non-root, so do not start it as root
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 8004
  runAsGroup: 8004

containerSecurityContext:
  readOnlyRootFilesystem: false # container writes into filesystem
  capabilities:
    add: []

service:
  enabled: false

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

# docker HEALTHCHECK CMD is reused as-is; it reads $SC_DONE_MARK_FILE at runtime
probes:
  startup:
    httpGet: null
    exec:
      command: ["/bin/sh", "/home/scu/services/migration/docker/healthcheck.sh"]
    periodSeconds: 5
    timeoutSeconds: 5
    failureThreshold: 100
  # once startup probe succeeds, migration has been done successfully
  # no need to check health further
  readiness: null
  liveness: null
