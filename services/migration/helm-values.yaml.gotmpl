{{- $doneMarkFile := "/tmp/migration.done" }}

image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/migration
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

service:
  enabled: false

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

env:
  HOME: /tmp
  POSTGRES_DB: {{ requiredEnv "POSTGRES_DB" | quote }}
  POSTGRES_HOST: {{ required "postgresHost must be set in the environment values" .Environment.Values.postgresHost | quote }}
  POSTGRES_MAX_OVERFLOW: {{ requiredEnv "POSTGRES_MAX_OVERFLOW" | quote }}
  POSTGRES_MAX_POOLSIZE: {{ requiredEnv "POSTGRES_MAX_POOLSIZE" | quote }}
  POSTGRES_PASSWORD: {{ requiredEnv "POSTGRES_PASSWORD" | quote }}
  POSTGRES_PORT: {{ requiredEnv "POSTGRES_PORT" | quote }}
  POSTGRES_USER: {{ requiredEnv "POSTGRES_USER" | quote }}
  SC_DONE_MARK_FILE: {{ $doneMarkFile | quote }}

probes:
  startup:
    httpGet: null
    exec:
      command: ["/bin/sh", "-c", "test -f {{ $doneMarkFile }}"]
    periodSeconds: 5
    timeoutSeconds: 5
    # 100 * 5s stays below the helmfile timeout
    failureThreshold: 100
  readiness:
    httpGet: null
    exec:
      command: ["/bin/sh", "-c", "test -f {{ $doneMarkFile }}"]
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 3
  liveness: null

networkPolicy:
  enabled: true
  egress:
    - to:
        - ipBlock:
            cidr: 10.0.0.0/8
        - ipBlock:
            cidr: 172.16.0.0/12
        - ipBlock:
            cidr: 192.168.0.0/16
      ports:
        - protocol: TCP
          port: {{ requiredEnv "POSTGRES_PORT" | int }}
