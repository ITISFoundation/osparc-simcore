          },
          "image_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Digest",
            "description": "Image manifest digest. Note that this is NOT injected as an image label"
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LowerCaseEmailStr"
              },
              {
                "type": "null"
              }
            ],
            "description": "None when the owner email cannot be found in the database"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "classifiers",
          "key",
          "version",
          "type",
          "authors",
          "contact",
