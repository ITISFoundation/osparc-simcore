{{- $sharedFolder := env "SIDECAR_COMP_SERVICES_SHARED_FOLDER" | default "/home/scu/computational_shared_data" -}}

# the worker serves nothing callers reach, the dask dashboard is probed by number in the base values
service:
  enabled: false

# compose mounts a volume here: entrypoint.sh mkdirs it as root, and without the dropped DAC_OVERRIDE cap that
# fails inside the scu-owned image home
extraVolumes:
  - name: docker-socket
    hostPath:
      path: /var/run/docker.sock
      type: Socket
  - name: computational-shared-data
    emptyDir: {}

extraVolumeMounts:
  - name: docker-socket
    mountPath: /var/run/docker.sock
  - name: computational-shared-data
    mountPath: {{ $sharedFolder | quote }}

# boot.sh defaults this to tls://, which the plain-tcp scheduler cannot answer
env:
  DASK_SCHEDULER_URL: tcp://{{ requiredEnv "DASK_SCHEDULER_HOST" }}:8786
