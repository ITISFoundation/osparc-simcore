api:
  dashboard: true

logs:
  general:
    level: WARN

additionalArguments:
  - --ping

ingressRoute:
  dashboard:
    enabled: true
    middlewares:
      - name: gzip

tracing:
  addInternals: true
  sampleRate: {{ requiredEnv "TRACING_OPENTELEMETRY_SAMPLING_PROBABILITY" }}
  otlp:
    enabled: true
    http:
      enabled: true
      endpoint: {{ printf "%s:%s/v1/tracing" (requiredEnv "TRACING_OPENTELEMETRY_COLLECTOR_ENDPOINT") (requiredEnv "TRACING_OPENTELEMETRY_COLLECTOR_PORT") | quote }}

service:
  type: NodePort

ports:
  traefik:
    expose:
      default: true
    nodePort: 30880
  web:
    nodePort: 30081
    forwardedHeaders:
      insecure: true
    transport:
      respondingTimeouts:
        readTimeout: 21600s
        writeTimeout: 21600s
  simcoreapi:
    port: 10081
    exposedPort: 10081
    expose:
      default: true
    nodePort: 31081 # host 10081
    forwardedHeaders:
      insecure: true
    transport:
      respondingTimeouts:
        readTimeout: 21600s
        writeTimeout: 21600s
  metrics:
    port: 8082

extraObjects:
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: gzip
    spec:
      compress: {}
  # ssl header necessary so that socket.io upgrades correctly from polling to websocket mode
  # the middleware must be attached to the right connection.
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: sslheader
    spec:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: http
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: webserver-retry
    spec:
      retry:
        attempts: 2
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: static-webserver-retry
    spec:
      retry:
        attempts: 2
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: api-server-ratelimit
    spec:
      rateLimit:
        average: 1
        period: 1m
        burst: 10
        sourceCriterion:
          ipStrategy:
            depth: 2
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: api-server-ensure-group-header
    spec:
      headers:
        customRequestHeaders:
          X-Inflight-Limit-Group: all
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: api-server-limit-reqs
    spec:
      inFlightReq:
        amount: {{ requiredEnv "TRAEFIK_API_SERVER_INFLIGHTREQ_AMOUNT" }}
        sourceCriterion:
          requestHeaderName: X-Inflight-Limit-Group
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: api-server-inflightreq
    spec:
      chain:
        middlewares:
          - name: api-server-ensure-group-header
          - name: api-server-limit-reqs
  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: api-server
      annotations:
        traefik.ingress.kubernetes.io/router.entrypoints: simcoreapi
        traefik.ingress.kubernetes.io/router.priority: "3"
        traefik.ingress.kubernetes.io/router.middlewares: {{ .Release.Namespace }}-gzip@kubernetescrd,{{ .Release.Namespace }}-api-server-ratelimit@kubernetescrd,{{ .Release.Namespace }}-api-server-inflightreq@kubernetescrd
    spec:
      ingressClassName: traefik
      rules:
        - http:
            paths:
              {{- range list "/" "/v0" "/api/v0/openapi.json" }}
              - path: {{ . }}
                pathType: Exact
                backend:
                  service:
                    name: api-server
                    port:
                      name: http
              {{- end }}
              - path: /v0/
                pathType: Prefix
                backend:
                  service:
                    name: api-server
                    port:
                      name: http
  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: webserver
      annotations:
        traefik.ingress.kubernetes.io/router.entrypoints: web
        traefik.ingress.kubernetes.io/router.priority: "6"
        traefik.ingress.kubernetes.io/router.pathmatcher: PathRegexp
        traefik.ingress.kubernetes.io/router.middlewares: {{ .Release.Namespace }}-gzip@kubernetescrd,{{ .Release.Namespace }}-sslheader@kubernetescrd,{{ .Release.Namespace }}-webserver-retry@kubernetescrd
    spec:
      ingressClassName: traefik
      rules:
        - http:
            paths:
              {{- range list "/" "/v0" "/socket.io/" "/static-frontend-data.json" "/view" "/#/view" "/#/error" }}
              - path: {{ . | quote }}
                pathType: Exact
                backend:
                  service:
                    name: webserver
                    port:
                      name: http
              {{- end }}
              - path: /v0/
                pathType: Prefix
                backend:
                  service:
                    name: webserver
                    port:
                      name: http
              - path: '/study/(?P<study_uuid>\b[0-9a-f]{8}\b-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-\b[0-9a-f]{12}\b)'
                pathType: ImplementationSpecific
                backend:
                  service:
                    name: webserver
                    port:
                      name: http
  # sticky sessions only for these endpoints, see
  # https://github.com/ITISFoundation/osparc-simcore/pull/4180; Traefik reads
  # stickiness from the backend Service, hence a second Service on the same pods
  - apiVersion: v1
    kind: Service
    metadata:
      name: webserver-sticky
      annotations:
        traefik.ingress.kubernetes.io/service.sticky.cookie: "true"
        traefik.ingress.kubernetes.io/service.sticky.cookie.secure: "true"
        traefik.ingress.kubernetes.io/service.sticky.cookie.httponly: "true"
        traefik.ingress.kubernetes.io/service.sticky.cookie.samesite: lax
    spec:
      selector:
        app.kubernetes.io/name: webserver
        app.kubernetes.io/instance: webserver
      ports:
        - name: http
          port: 8080
          targetPort: http
  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: webserver-sticky
      annotations:
        traefik.ingress.kubernetes.io/router.entrypoints: web
        traefik.ingress.kubernetes.io/router.priority: "8"
        traefik.ingress.kubernetes.io/router.pathmatcher: PathRegexp
        traefik.ingress.kubernetes.io/router.middlewares: {{ .Release.Namespace }}-gzip@kubernetescrd,{{ .Release.Namespace }}-sslheader@kubernetescrd,{{ .Release.Namespace }}-webserver-retry@kubernetescrd
    spec:
      ingressClassName: traefik
      rules:
        - http:
            paths:
              {{- range list "/v0/projects" "/v0/projects:clone" }}
              - path: {{ . }}
                pathType: Exact
                backend:
                  service:
                    name: webserver-sticky
                    port:
                      name: http
              {{- end }}
              {{- range list
                "/v0/projects/[0-9a-fA-F-]+/nodes/[0-9a-fA-F-]+:stop"
                "/v0/projects/[0-9a-fA-F-]+/nodes/[0-9a-fA-F-]+:open"
                "/v0/projects/[0-9a-fA-F-]+/nodes/[0-9a-fA-F-]+:close"
                "/v0/storage/locations/[0-9]+/paths/.+:size"
                "/v0/storage/locations/[0-9]+/-/paths:batchDelete"
                "/v0/storage/locations/[0-9]+:export-data"
                "/v0/tasks-legacy/.+"
              }}
              - path: {{ . | squote }}
                pathType: ImplementationSpecific
                backend:
                  service:
                    name: webserver-sticky
                    port:
                      name: http
              {{- end }}
  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: static-webserver
      annotations:
        traefik.ingress.kubernetes.io/router.entrypoints: web
        traefik.ingress.kubernetes.io/router.priority: "6"
        traefik.ingress.kubernetes.io/router.middlewares: {{ .Release.Namespace }}-gzip@kubernetescrd,{{ .Release.Namespace }}-static-webserver-retry@kubernetescrd
    spec:
      ingressClassName: traefik
      rules:
        - http:
            paths:
              {{- range list "osparc" "s4l" "s4llite" "s4lacad" "s4lengine" "s4ldesktop" "s4ldesktopacad" "tis" "tiplite" "transpiled" "resource" }}
              - path: /{{ . }}
                pathType: Exact
                backend:
                  service:
                    name: static-webserver
                    port:
                      name: http
              - path: /{{ . }}/
                pathType: Prefix
                backend:
                  service:
                    name: static-webserver
                    port:
                      name: http
              {{- end }}
