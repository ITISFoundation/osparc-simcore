image:
  repository: local/invitations
  tag: development

containerSecurityContext:
  readOnlyRootFilesystem: false

resources:
  limits:
    memory: 2Gi

probes:
  startup:
    failureThreshold: 120

service:
  type: NodePort
  nodePort: 30008
  extraServicePorts:
    - name: debug
      port: 3000
      nodePort: 32017

env:
  INVITATIONS_REMOTE_DEBUGGING_PORT: 3000
  INVITATIONS_LOGLEVEL: DEBUG

extraVolumes:
  - name: invitations-src
    hostPath:
      path: /osparc-simcore/services/invitations
      type: Directory
  - name: packages-src
    hostPath:
      path: /osparc-simcore/packages
      type: Directory

extraVolumeMounts:
  - name: invitations-src
    mountPath: /devel/services/invitations
  - name: packages-src
    mountPath: /devel/packages
