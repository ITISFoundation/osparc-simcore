image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/resource-usage-tracker
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

env:
  PROMETHEUS_URL: {{ env "RESOURCE_USAGE_TRACKER_PROMETHEUS_URL" | quote }}
  PROMETHEUS_USERNAME: {{ env "RESOURCE_USAGE_TRACKER_PROMETHEUS_USERNAME" | quote }}
  RESOURCE_USAGE_TRACKER_LOGLEVEL: {{ requiredEnv "RESOURCE_USAGE_TRACKER_LOGLEVEL" | quote }}
  RESOURCE_USAGE_TRACKER_MISSED_HEARTBEAT_CHECK_ENABLED: {{ requiredEnv "RESOURCE_USAGE_TRACKER_MISSED_HEARTBEAT_CHECK_ENABLED" | quote }}
  RESOURCE_USAGE_TRACKER_MISSED_HEARTBEAT_COUNTER_FAIL: {{ requiredEnv "RESOURCE_USAGE_TRACKER_MISSED_HEARTBEAT_COUNTER_FAIL" | quote }}
  RESOURCE_USAGE_TRACKER_MISSED_HEARTBEAT_INTERVAL_SEC: {{ requiredEnv "RESOURCE_USAGE_TRACKER_MISSED_HEARTBEAT_INTERVAL_SEC" | quote }}
  RESOURCE_USAGE_TRACKER_PORT: {{ requiredEnv "RESOURCE_USAGE_TRACKER_PORT" | quote }}
  RESOURCE_USAGE_TRACKER_S3: {{ requiredEnv "RESOURCE_USAGE_TRACKER_S3" | quote }}
  RESOURCE_USAGE_TRACKER_TRACING: {{ requiredEnv "RESOURCE_USAGE_TRACKER_TRACING" | quote }}

secretEnv:
  PROMETHEUS_PASSWORD: {{ env "RESOURCE_USAGE_TRACKER_PROMETHEUS_PASSWORD" | quote }}
