image:
  repository: local/resource-usage-tracker
  tag: development

containerSecurityContext:
  readOnlyRootFilesystem: false

resources:
  limits:
    memory: 2Gi

probes:
  startup:
    failureThreshold: 120

service:
  type: NodePort
  nodePort: 30009
  extraServicePorts:
    - name: debug
      port: 3000
      nodePort: 32014

env:
  RESOURCE_USAGE_TRACKER_REMOTE_DEBUGGING_PORT: 3000
  RESOURCE_USAGE_TRACKER_LOGLEVEL: DEBUG

extraVolumes:
  - name: resource-usage-tracker-src
    hostPath:
      path: /osparc-simcore/services/resource-usage-tracker
      type: Directory
  - name: packages-src
    hostPath:
      path: /osparc-simcore/packages
      type: Directory

extraVolumeMounts:
  - name: resource-usage-tracker-src
    mountPath: /devel/services/resource-usage-tracker
  - name: packages-src
    mountPath: /devel/packages
