image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/autoscaling
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

# entrypoint.sh runs update-ca-certificates and adds scu to the docker socket's group, both need a writable /etc
containerSecurityContext:
  readOnlyRootFilesystem: false

extraVolumes:
  - name: docker-socket
    hostPath:
      path: /var/run/docker.sock
      type: Socket

extraVolumeMounts:
  - name: docker-socket
    mountPath: /var/run/docker.sock

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

env:
  AUTOSCALING_DASK: {{ requiredEnv "AUTOSCALING_DASK" | quote }}
  AUTOSCALING_DOCKER_JOIN_DRAINED: {{ requiredEnv "AUTOSCALING_DOCKER_JOIN_DRAINED" | quote }}
  AUTOSCALING_DRAIN_NODES_WITH_LABELS: {{ requiredEnv "AUTOSCALING_DRAIN_NODES_WITH_LABELS" | quote }}
  AUTOSCALING_EC2_ACCESS: {{ requiredEnv "AUTOSCALING_EC2_ACCESS" | quote }}
  AUTOSCALING_EC2_ACCESS_KEY_ID: {{ env "AUTOSCALING_EC2_ACCESS_KEY_ID" | quote }}
  AUTOSCALING_EC2_INSTANCES: {{ requiredEnv "AUTOSCALING_EC2_INSTANCES" | quote }}
  AUTOSCALING_EC2_REGION_NAME: {{ env "AUTOSCALING_EC2_REGION_NAME" | quote }}
  AUTOSCALING_LOGLEVEL: {{ requiredEnv "AUTOSCALING_LOGLEVEL" | quote }}
  AUTOSCALING_NODES_MONITORING: {{ requiredEnv "AUTOSCALING_NODES_MONITORING" | quote }}
  AUTOSCALING_POLL_INTERVAL: {{ requiredEnv "AUTOSCALING_POLL_INTERVAL" | quote }}
  AUTOSCALING_SSM_ACCESS: {{ requiredEnv "AUTOSCALING_SSM_ACCESS" | quote }}
  AUTOSCALING_TRACING: {{ requiredEnv "AUTOSCALING_TRACING" | quote }}
  AUTOSCALING_WAIT_FOR_CLOUD_INIT_BEFORE_WARM_BUFFER_ACTIVATION: {{ requiredEnv "AUTOSCALING_WAIT_FOR_CLOUD_INIT_BEFORE_WARM_BUFFER_ACTIVATION" | quote }}
  DASK_MONITORING_URL: {{ env "DASK_MONITORING_URL" | quote }}
  DASK_SCHEDULER_AUTH: {{ env "DASK_SCHEDULER_AUTH" | quote }}
  EC2_INSTANCES_ALLOWED_TYPES: {{ env "EC2_INSTANCES_ALLOWED_TYPES" | quote }}
  EC2_INSTANCES_ATTACHED_IAM_PROFILE: {{ env "EC2_INSTANCES_ATTACHED_IAM_PROFILE" | quote }}
  EC2_INSTANCES_COLD_START_DOCKER_IMAGES_PRE_PULLING: {{ env "EC2_INSTANCES_COLD_START_DOCKER_IMAGES_PRE_PULLING" | quote }}
  EC2_INSTANCES_CUSTOM_TAGS: {{ env "EC2_INSTANCES_CUSTOM_TAGS" | quote }}
  EC2_INSTANCES_KEY_NAME: {{ env "EC2_INSTANCES_KEY_NAME" | quote }}
  EC2_INSTANCES_MAX_INSTANCES: {{ env "EC2_INSTANCES_MAX_INSTANCES" | quote }}
  EC2_INSTANCES_MAX_START_TIME: {{ env "EC2_INSTANCES_MAX_START_TIME" | quote }}
  EC2_INSTANCES_NAME_PREFIX: {{ env "EC2_INSTANCES_NAME_PREFIX" | quote }}
  EC2_INSTANCES_SECURITY_GROUP_IDS: {{ env "EC2_INSTANCES_SECURITY_GROUP_IDS" | quote }}
  EC2_INSTANCES_SUBNET_IDS: {{ env "EC2_INSTANCES_SUBNET_IDS" | quote }}
  EC2_INSTANCES_TIME_BEFORE_DRAINING: {{ env "EC2_INSTANCES_TIME_BEFORE_DRAINING" | quote }}
  EC2_INSTANCES_TIME_BEFORE_TERMINATION: {{ env "EC2_INSTANCES_TIME_BEFORE_TERMINATION" | quote }}
  NODES_MONITORING_NEW_NODES_LABELS: {{ env "NODES_MONITORING_NEW_NODES_LABELS" | quote }}
  NODES_MONITORING_NODE_LABELS: {{ env "NODES_MONITORING_NODE_LABELS" | quote }}
  NODES_MONITORING_SERVICE_LABELS: {{ env "NODES_MONITORING_SERVICE_LABELS" | quote }}
  SSM_ACCESS_KEY_ID: {{ env "SSM_ACCESS_KEY_ID" | quote }}
  SSM_ENDPOINT: {{ env "SSM_ENDPOINT" | quote }}
  SSM_REGION_NAME: {{ env "SSM_REGION_NAME" | quote }}

secretEnv:
  AUTOSCALING_EC2_SECRET_ACCESS_KEY: {{ env "AUTOSCALING_EC2_SECRET_ACCESS_KEY" | quote }}
  SSM_SECRET_ACCESS_KEY: {{ env "SSM_SECRET_ACCESS_KEY" | quote }}
